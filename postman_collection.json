{
  "info": {
    "name": "Backend AC - Absolute Cinema API",
    "description": "API Collection untuk testing Backend Absolute Cinema",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\",\n  \"phone\": \"081234567890\",\n  \"role\": \"customer\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/register",
              "host": ["{{base_url}}"],
              "path": ["register"]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@test.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": ["{{base_url}}"],
              "path": ["login"]
            }
          }
        }
      ]
    },
    {
      "name": "Public",
      "item": [
        {
          "name": "Get Films",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/films",
              "host": ["{{base_url}}"],
              "path": ["films"]
            }
          }
        },
        {
          "name": "Get Film Detail",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/films/1",
              "host": ["{{base_url}}"],
              "path": ["films", "1"]
            }
          }
        },
        {
          "name": "Get Schedules by Film",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/schedules/1",
              "host": ["{{base_url}}"],
              "path": ["schedules", "1"]
            }
          }
        },
        {
          "name": "Get Seats by Schedule",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/seats/1",
              "host": ["{{base_url}}"],
              "path": ["seats", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Customer",
      "item": [
        {
          "name": "Checkout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"schedule_id\": 1,\n  \"seat_ids\": [1, 2]\n}"
            },
            "url": {
              "raw": "{{base_url}}/checkout",
              "host": ["{{base_url}}"],
              "path": ["checkout"]
            }
          }
        },
        {
          "name": "Get Orders",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/orders",
              "host": ["{{base_url}}"],
              "path": ["orders"]
            }
          }
        }
      ]
    }
  ]
}